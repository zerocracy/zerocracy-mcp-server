{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": [
        "patch"
      ]
    },
    {
      "automerge": true,
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "automerge": true,
      "groupName": "typescript-eslint packages",
      "matchPackageNames": [
        "@typescript-eslint/{/,}**"
      ]
    }
  ],
  "platformAutomerge": false,
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
